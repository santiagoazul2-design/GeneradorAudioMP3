<Window x:Class="GeneradorAudioMP3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generador de Audio MP3" Height="600" Width="800"
        Background="#F5F5F5" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" MinHeight="500" MinWidth="600">
    <Grid>
        <StackPanel Margin="20" VerticalAlignment="Stretch">
            <!-- Título -->
            <TextBlock Text="🎵 Generador de Audio MP3"
                       FontSize="28" FontWeight="Bold"
                       Foreground="#333333" Margin="0,0,0,20"/>

            <!-- Entrada de texto -->
            <TextBlock Text="Ingresa el texto a convertir:" 
                       FontSize="12" FontWeight="SemiBold" Foreground="#666666"/>
            <TextBox x:Name="TextInput"
                     Height="120" Margin="0,5,0,15"
                     Padding="10" FontSize="12"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>

            <!-- Configuración de voz -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Idioma -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Idioma:" FontSize="11" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,5"/>
                    <ComboBox x:Name="LanguageCombo" Height="35" Padding="10,8">
                        <ComboBoxItem Content="Español" IsSelected="True"/>
                        <ComboBoxItem Content="Inglés"/>
                        <ComboBoxItem Content="Francés"/>
                    </ComboBox>
                </StackPanel>

                <!-- Género de voz -->
                <StackPanel Grid.Column="1" Margin="5,0,5,0">
                    <TextBlock Text="Voz:" FontSize="11" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,5"/>
                    <ComboBox x:Name="VoiceCombo" Height="35" Padding="10,8">
                        <ComboBoxItem Content="Masculina" IsSelected="True"/>
                        <ComboBoxItem Content="Femenina"/>
                    </ComboBox>
                </StackPanel>

                <!-- Velocidad -->
                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                    <TextBlock Text="Velocidad:" FontSize="11" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,5"/>
                    <ComboBox x:Name="SpeedCombo" Height="35" Padding="10,8">
                        <ComboBoxItem Content="Lenta"/>
                        <ComboBoxItem Content="Normal" IsSelected="True"/>
                        <ComboBoxItem Content="Rápida"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Volumen y tono -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Volumen -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Volumen:" FontSize="11" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="VolumeSlider" Width="150" VerticalAlignment="Center" 
                                Minimum="0" Maximum="100" Value="100" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="VolumeLabel" Text="100%" Margin="10,0,0,0" 
                                   VerticalAlignment="Center" Foreground="#666666" Width="40"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tono -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Tono:" FontSize="11" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="PitchSlider" Width="150" VerticalAlignment="Center" 
                                Minimum="-10" Maximum="10" Value="0" IsSnapToTickEnabled="True"/>
                        <TextBlock x:Name="PitchLabel" Text="Normal" Margin="10,0,0,0" 
                                   VerticalAlignment="Center" Foreground="#666666" Width="60"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Estado -->
            <TextBlock x:Name="StatusText" Text="Listo para generar audio."
                       FontSize="11" Foreground="#0066CC" Margin="0,0,0,15" MinHeight="20"/>

            <!-- Botones -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="GenerateButton" Content="🎤 Generar MP3"
                        Height="40" Padding="20,0" FontSize="14" FontWeight="Bold"
                        Background="#0066CC" Foreground="White" Cursor="Hand"
                        Margin="0,0,10,0" Click="GenerateButton_Click"/>
                
                <Button x:Name="PreviewButton" Content="▶ Preescuchar"
                        Height="40" Padding="20,0" FontSize="14" FontWeight="Bold"
                        Background="#28A745" Foreground="White" Cursor="Hand"
                        Click="PreviewButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
